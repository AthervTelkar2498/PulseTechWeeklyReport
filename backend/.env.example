# ═══════════════════════════════════════════════════════════════════
# PulseTech FAERS Pediatric ADR — Configuration (TEMPLATE)
# ═══════════════════════════════════════════════════════════════════
# IMPORTANT: Copy this file to .env and fill in your own values.
# DO NOT commit .env to version control.
# © 2026 PulseTech (ANC-031) — For Educational Use Only.

DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@localhost:5432/faers_pediatric
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:YOUR_DB_PASSWORD@localhost:5432/faers_pediatric
REDIS_URL=redis://localhost:6379/0
RXNORM_API_BASE=https://rxnav.nlm.nih.gov/REST
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_256BIT_KEY

# Skip RxNorm API for faster local testing (set to 1 to skip)
SKIP_RXNORM=1

# GNN checkpoints
GNN_CHECKPOINT_DIR=./gnn/checkpoints/
GNN_DEVICE=cuda
SIGNAL_MIN_N=3
ACTIVE_QUARTERS=2025Q1,2025Q2,2025Q3,2025Q4

# ═══════════════════════════════════════════════════════════════════
# SECURITY CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

# JWT Secret (MUST change in production!)
PULSETECH_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY

# Admin credentials (MUST change!)
PULSETECH_ADMIN_USER=CHANGE_ME
PULSETECH_ADMIN_PASS=CHANGE_ME

# CORS: Allowed frontend origin
ALLOWED_ORIGIN=http://localhost:5173

# IP Whitelist (empty = allow all. Comma-separated IPs for production)
PULSETECH_IP_WHITELIST=

# Rate limit (requests per minute per IP)
PULSETECH_RATE_LIMIT=100

# License key (empty = dev mode, no license check)
PULSETECH_LICENSE_KEY=
PULSETECH_LICENSE_EXPIRY=2027-12-31

# Production mode (disables /docs and /redoc Swagger endpoints)
# PULSETECH_PRODUCTION=1

# File integrity baseline
# PULSETECH_INTEGRITY_FILE=integrity.sha256

# Audit log file
PULSETECH_AUDIT_LOG=security_audit.log
